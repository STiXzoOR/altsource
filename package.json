{
  "name": "altsource",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STiX Apps — an AltStore PAL and AltStore Classic source",
  "bin": {
    "altsource": "bin/altsource.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'",
    "validate": "node bin/altsource.mjs validate",
    "build": "node bin/altsource.mjs build --out .altsource && astro build",
    "dev": "node bin/altsource.mjs build --out .altsource && astro dev",
    "preview": "npm run build && astro preview",
    "serve": "node bin/altsource.mjs serve",
    "assets:brand": "node scripts/make-brand-assets.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "bplist-parser": "^0.3.2",
    "fflate": "^0.8.3",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "marked": "^18.0.11",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4.3.3"
  }
}

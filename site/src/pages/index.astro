---
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import Pill from '../components/Pill.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SourceURLChip from '../components/SourceURLChip.astro';
import AppRow from '../components/AppRow.astro';
import NewsCard from '../components/NewsCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Shelf from '../components/Shelf.astro';
import Ribbon from '../components/Ribbon.astro';
import Text from '../components/Text.astro';
import ActionSheet from '../components/ActionSheet.astro';
import Wordmark from '../components/Wordmark.astro';
import StoreSwitch from '../components/StoreSwitch.astro';
import SettingsSheet from '../components/SettingsSheet.astro';
import { getSite, universalLink, formatDate } from '../lib/data.mjs';
const site = await getSite();
const base = import.meta.env.BASE_URL;
const { meta, apps, featured, news, counts } = site;
const rows = featured.length ? featured : apps.slice(0, 6);
const river = (featured.length ? featured : apps).slice(0, 12);
const latest = [...apps.map((e) => e.latest.date), ...news.map((n) => n.date)].filter(Boolean).sort().at(-1);
const facts = [
  { label: 'Apps', value: String(apps.length), sub: 'in this source', href: `${base}apps/` },
  { label: 'AltStore PAL', value: String(counts.pal), sub: 'notarized' },
  { label: 'Sideload', value: String(counts.classic), sub: 'Classic · SideStore' },
  { label: 'News', value: String(news.length), sub: news.length === 1 ? 'post' : 'posts', href: `${base}news/` },
  ...(latest ? [{ label: 'Updated', value: formatDate(latest).replace(/ \d{4}$/, ''), sub: latest.slice(0, 4) }] : []),
].filter((f) => f.value !== '0');
const addLinks = [
  { store: 'pal', cta: 'Add to AltStore', label: 'Add to AltStore PAL', href: universalLink(site.urls.pal), primary: true },
  { store: 'classic', cta: 'Add to AltStore', label: 'Add to AltStore Classic', href: universalLink(site.urls.classic) },
  { store: 'sidestore', cta: 'Add to SideStore', label: 'Add to SideStore', href: `sidestore://source?url=${encodeURIComponent(site.urls.classic)}` },
];
const addActions = [
  ...addLinks.map(({ store, cta, ...a }) => a),
  { label: 'Copy PAL link', copy: site.urls.pal, stores: 'pal' },
  { label: 'Copy Classic link', copy: site.urls.classic, stores: 'classic sidestore' },
];
const qrs = [
  { label: 'AltStore PAL', svg: site.qr.pal, stores: 'pal' },
  { label: 'AltStore Classic · SideStore', svg: site.qr.classic, stores: 'classic sidestore' },
];
const empty = { all: 'No apps yet. Add the source now and they will appear as they are published.', pal: 'Nothing for AltStore PAL yet.', classic: 'Nothing for AltStore Classic yet.', sidestore: 'Nothing for SideStore yet.' };
const emptyAttrs = { 'data-empty': '', 'data-empty-pal': empty.pal, 'data-empty-classic': empty.classic, 'data-empty-sidestore': empty.sidestore };
const website = meta.website ? meta.website.replace(/^https?:\/\//, '').replace(/\/$/, '') : null;
---
<Base width="wide" flush>
  <NavBar slot="nav" icon={meta.iconURL} tinted>
    <Wordmark slot="title" name={meta.name} class="truncate text-[1.05em]" />
    <span slot="trailing" class="contents">
      <Pill label="Add" data-store-only="all" data-sheet="add-source" />
      {addLinks.map((l) => <Pill label="Add" href={l.href} data-store-only={l.store} />)}
    </span>
    <button slot="actions" type="button" class="navbar-action" data-sheet="settings" aria-label="Settings" aria-haspopup="dialog"><Icon name="Settings01Icon" class="size-6" strokeWidth={1.75} /></button>
  </NavBar>

  <section class="hero-midnight relative -mx-4 overflow-hidden px-4 pt-[calc(60px+env(safe-area-inset-top,0px))] pb-6 xs:-mx-[25px] xs:px-[25px] lg:mx-0 lg:mt-2 lg:min-h-[286px] lg:rounded-card lg:px-10 lg:py-10" aria-labelledby="source-title">
    <div class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-5 sm:gap-x-8 lg:items-center lg:gap-x-12">
      <div class="min-w-0">
        <h1 id="source-title" class="leading-none tracking-tight"><Wordmark name={meta.name} stacked class="text-[2.75rem] sm:text-[3.25rem] lg:text-[4rem]" /></h1>
        {meta.subtitle && <p class="mt-3 t-body text-white/70 lg:mt-4 lg:t-title-2-em lg:text-[rgba(246,246,246,.6)]">{meta.subtitle}</p>}
      </div>
      <img src={meta.iconURL} alt="" width="194" height="194" class="hero-tile size-24 shrink-0 sm:size-32 lg:size-[194px] lg:row-span-3 lg:self-center" />
      <Ribbon items={facts} onDark class="col-span-2 lg:col-span-1 mt-4 lg:mt-5 lg:max-w-[600px]" />
      <div class="col-span-2 lg:col-span-1 mt-5 flex flex-wrap items-center gap-2.5 lg:mt-6">
          <button type="button" class="get get-blue min-h-8" data-store-only="all" data-sheet="add-source" aria-haspopup="dialog">Add to AltStore</button>
          {addLinks.map((l) => <a href={l.href} class="get get-blue min-h-8" data-store-only={l.store}>{l.cta}</a>)}
          <button type="button" class="get get-glass min-h-8 px-[7px] lg:gap-2 lg:px-4" data-share data-share-url={site.urls.pal} data-share-title={meta.name} aria-label="Share"><Icon name="Share01Icon" class="size-4" strokeWidth={2} /><span class="hidden lg:inline">Share</span></button>
          <span class="sr-only" aria-live="polite" data-share-status></span>
      </div>
    </div>
  </section>
  <div data-nav-sentinel></div>
  <div class="mt-3 lg:hidden"><StoreSwitch class="w-full" /></div>
  <div class="mt-4 hidden max-w-[840px] gap-2 lg:grid lg:grid-cols-2">
    <div class="min-w-0" data-stores="pal"><SourceURLChip label="PAL" url={site.urls.pal} /></div>
    <div class="min-w-0" data-stores="classic sidestore"><SourceURLChip label="Classic" url={site.urls.classic} /></div>
  </div>

  {featured.length > 0 && (
    <section class="mt-8 hidden lg:block" aria-labelledby="featured-h">
      <SectionHeader id="featured-h" title="Featured" href={`${base}apps/`} />
      <Shelf class="[--shelf-col-lg:407px]">{featured.map((entry) => <FeatureCard entry={entry} />)}</Shelf>
    </section>
  )}

  {news.length > 0 && (
    <section class="mt-8" aria-labelledby="news-h">
      <SectionHeader id="news-h" title="News" href={`${base}news/`} linkLabel="View All" />
      <Shelf class="[--shelf-col:min(88vw,340px)] [--shelf-n:3]">{news.slice(0, 6).map((item) => <NewsCard item={item} apps={apps} minimal />)}</Shelf>
    </section>
  )}

  <section class="mt-8" aria-labelledby="apps-h">
    <SectionHeader id="apps-h" title={featured.length ? 'Featured Apps' : 'Apps'} href={`${base}apps/`} linkLabel="View All Apps" />
    <div class="lg:hidden" data-app-list>
      {rows.length === 0 ? <p class="rounded-[20px] bg-surface p-6 text-center t-body text-label-2">{empty.all}</p> : <div class="grid gap-2.5 sm:grid-cols-2">{rows.map((entry) => <AppRow entry={entry} />)}</div>}
      <p class="rounded-[20px] bg-surface p-6 text-center t-body text-label-2" hidden {...emptyAttrs}></p>
    </div>
    <div class="hidden lg:block" data-app-list>
      {river.length === 0 ? <p class="rounded-box bg-surface p-6 text-center t-body text-label-2">{empty.all}</p> : <div class="grid gap-x-5 gap-y-6 lg:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">{river.map((entry) => <AppRow entry={entry} />)}</div>}
      <p class="rounded-box bg-surface p-6 text-center t-body text-label-2" hidden {...emptyAttrs}></p>
    </div>
  </section>

  {(meta.description || meta.website) && (
    <section class="mt-8" aria-labelledby="about-h">
      <SectionHeader id="about-h" title="About" />
      <div class="lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-8">
        <div class="t-body lg:t-body-tall">{meta.description && <Text text={meta.description} clamp={5} />}</div>
        {meta.website && <p class="mt-3 lg:mt-0"><a href={meta.website} rel="noopener" class="inline-flex items-center gap-1 t-body text-key hover:underline lg:t-callout-em">{website}<span aria-hidden="true">↗</span></a></p>}
      </div>
    </section>
  )}
  <SettingsSheet />
  <ActionSheet id="add-source" title={`Add "${meta.name}"`} message="Choose the app you use. The source keeps your apps updated." actions={addActions} qr={qrs} />
</Base>
<script>
  for (const b of document.querySelectorAll('[data-share]')) {
    b.addEventListener('click', async () => {
      const url = b.dataset.shareUrl, title = b.dataset.shareTitle;
      const status = document.querySelector('[data-share-status]');
      try {
        if (navigator.share) await navigator.share({ title, url });
        else { await navigator.clipboard.writeText(url); if (status) { status.textContent = 'Link copied'; setTimeout(() => { status.textContent = ''; }, 1500); } }
      } catch {}
    });
  }
</script>

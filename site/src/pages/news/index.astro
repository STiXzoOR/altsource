---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getSite } from '../../lib/data.mjs';
const { news, apps } = await getSite();
---
<Base title="News" description="Announcements and updates.">
  <h1 class="mt-8 mb-4 text-2xl font-bold">News</h1>
  {news.length === 0 ? (
    <p class="rounded-2xl border border-dashed border-zinc-300 p-8 text-center text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">Nothing yet.</p>
  ) : (
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{news.map((item) => <NewsCard item={item} apps={apps} />)}</div>
  )}
</Base>

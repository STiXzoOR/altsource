---
import { linkify } from '../lib/data.mjs';
const { text, clamp = false, class: cls = '' } = Astro.props;
const html = linkify(text);
---
{clamp ? (
  <div class={`group ${cls}`} data-clamp>
    <p class="line-clamp-5 whitespace-pre-line text-zinc-700 dark:text-zinc-300 group-data-[open]:line-clamp-none" set:html={html}></p>
    <button type="button" class="mt-1 hidden text-sm font-semibold text-accent group-data-[overflow]:inline" data-toggle>more</button>
  </div>
) : (
  <p class={`whitespace-pre-line text-zinc-700 dark:text-zinc-300 ${cls}`} set:html={html}></p>
)}
<script>
  for (const box of document.querySelectorAll('[data-clamp]')) {
    const p = box.querySelector('p');
    const btn = box.querySelector('[data-toggle]');
    if (p.scrollHeight > p.clientHeight + 2) box.setAttribute('data-overflow', '');
    btn?.addEventListener('click', () => {
      const open = box.toggleAttribute('data-open');
      btn.textContent = open ? 'less' : 'more';
    });
  }
</script>

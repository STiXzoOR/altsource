---
import { normalizeTint } from '../lib/tint.mjs';
import { storesFor } from '../lib/stores.mjs';
/** One app: an AltStore-style tinted row on phones, an App Store small lockup from 1000px. `morph` names the icon for the view transition (one per page). */
const { entry, label = 'Get', href, link = true, heading = false, morph = false } = Astro.props;
const NameTag = heading ? 'h1' : 'p';
const { app, kinds } = entry;
const base = import.meta.env.BASE_URL;
const target = href ?? `${base}apps/${encodeURIComponent(app.bundleIdentifier)}/`;
const style = app.tintColor ? `--tint: ${normalizeTint(app.tintColor)}` : undefined;
const Tag = link ? 'a' : 'div';
const iconStyle = morph ? `view-transition-name: icon-${app.bundleIdentifier.replace(/[^a-zA-Z0-9-]/g, '-')}` : undefined;
---
<Tag href={link ? target : undefined} class="approw" style={style}
  data-app data-name={`${app.name} ${app.subtitle ?? ''} ${app.developerName}`.toLowerCase()} data-category={app.category ?? 'other'} data-kinds={kinds.join(' ')} data-stores={storesFor(kinds)}>
  <img src={app.iconURL} alt="" width="64" height="64" loading="lazy" class="app-icon relative size-[59px] shrink-0 rounded-[13px] bg-surface object-cover lg:size-16 lg:rounded-[25%]" style={iconStyle} />
  <div class="relative flex min-w-0 flex-1 items-center justify-between gap-3">
    <div class="min-w-0">
      <NameTag class="truncate t-body font-bold lg:t-title-3-em">{app.name}</NameTag>
      <p class="truncate t-subhead text-label-2 lg:t-callout">{app.subtitle ?? app.developerName}</p>
    </div>
    <slot name="button"><span class="pill shrink-0 lg:hidden">{label}</span><span class="get hidden shrink-0 lg:inline-flex">{label}</span></slot>
  </div>
</Tag>

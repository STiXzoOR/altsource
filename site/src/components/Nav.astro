---
import Icon from './Icon.astro';
import { getSite } from '../lib/data.mjs';
const site = await getSite();
const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
const links = [['Apps', `${base}apps/`, 'grid'], ['News', `${base}news/`, 'newspaper'], ['Status', `${base}status/`, 'activity']];
const active = (href) => here.startsWith(href);
---
<header class="sticky top-0 z-40 border-b border-zinc-200/70 bg-zinc-50/80 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/80">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a href={base} class="flex min-w-0 items-center gap-2 font-semibold">
      <img src={site.meta.iconURL} alt="" width="28" height="28" class="size-7 rounded-lg" />
      <span class="truncate">{site.meta.name}</span>
    </a>
    <nav class="ml-auto flex items-center gap-1" aria-label="Primary">
      {links.map(([label, href, icon]) => (
        <a href={href} class={`flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium hover:bg-zinc-200/70 dark:hover:bg-zinc-800 ${active(href) ? 'text-accent' : 'text-zinc-600 dark:text-zinc-300'}`} aria-current={active(href) ? 'page' : undefined}>
          <Icon name={icon} class="size-4" /><span class="hidden sm:inline">{label}</span>
        </a>
      ))}
      <button type="button" data-theme-toggle class="ml-1 rounded-lg p-2 text-zinc-600 hover:bg-zinc-200/70 dark:text-zinc-300 dark:hover:bg-zinc-800" aria-label="Toggle dark mode">
        <span class="dark:hidden"><Icon name="moon" class="size-4" /></span>
        <span class="hidden dark:inline"><Icon name="sun" class="size-4" /></span>
      </button>
    </nav>
  </div>
</header>
<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });
</script>

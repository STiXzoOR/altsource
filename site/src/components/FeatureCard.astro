---
import { screenshotsOf, categoryLabel } from '../lib/data.mjs';
import { normalizeTint } from '../lib/tint.mjs';
import { storesFor } from '../lib/stores.mjs';
/** App Store "Today" card for a featured app: artwork under a protection layer, eyebrow, big title, blurb and an app row. */
const { entry } = Astro.props;
const { app, kinds } = entry;
const base = import.meta.env.BASE_URL;
const shot = screenshotsOf(app).iphone[0];
const tint = normalizeTint(app.tintColor ?? '#3b82f6');
const category = categoryLabel(app.category);
---
<a href={`${base}apps/${encodeURIComponent(app.bundleIdentifier)}/`} class="today" style={`--today-accent: ${tint}`} data-stores={storesFor(kinds)}>
  {shot ? <img src={shot.imageURL} alt="" width={shot.width} height={shot.height} loading="lazy" class="today-art" /> : <img src={app.iconURL} alt="" loading="lazy" class="today-icon-art" />}
  <div class="today-protect" aria-hidden="true"></div>
  <div class="today-text">
    <p class="today-eyebrow">{category}</p>
    <h3 class="today-title">{app.name}</h3>
    {app.subtitle && <p class="today-blurb line-clamp-2">{app.subtitle}</p>}
  </div>
  <div class="today-row">
    <img src={app.iconURL} alt="" width="48" height="48" loading="lazy" class="size-12 shrink-0 rounded-[25%] bg-black/20" />
    <div class="min-w-0 flex-1"><p class="truncate t-title-3-em">{app.name}</p><p class="truncate t-callout text-white/65">{app.developerName}</p></div>
    <span class="get get-glass">View</span>
  </div>
</a>

---
import Icon from './Icon.astro';
import { entitlementInfo, privacyInfo } from '../lib/permissions.mjs';
const { app } = Astro.props;
const ents = (app.appPermissions?.entitlements ?? []).map(entitlementInfo);
const priv = Object.entries(app.appPermissions?.privacy ?? {}).map(([k, v]) => privacyInfo(k, v));
const Item = null;
---
<section class="mt-8" aria-labelledby="perm-h">
  <h2 id="perm-h" class="mb-3 text-lg font-semibold">App permissions</h2>
  {ents.length === 0 && priv.length === 0 ? (
    <p class="text-sm text-zinc-500 dark:text-zinc-400">{app.appPermissions ? 'This app declares no additional entitlements or privacy usage.' : 'The source does not list permissions for this app.'}</p>
  ) : (
    <div class="grid gap-4 md:grid-cols-2">
      {[['Privacy', 'lock', priv], ['Entitlements', 'shield', ents]].filter(([, , list]) => list.length).map(([title, icon, list]) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-900">
          <h3 class="mb-2 flex items-center gap-2 text-sm font-semibold text-zinc-500 dark:text-zinc-400"><Icon name={icon} class="size-4" />{title}</h3>
          <ul class="divide-y divide-zinc-100 dark:divide-zinc-800">
            {list.map((p) => (
              <li class="py-2">
                <p class="font-medium">{p.name}</p>
                <p class="text-sm text-zinc-600 dark:text-zinc-400">{p.description}</p>
                <p class="mt-0.5 font-mono text-[11px] text-zinc-400">{p.key}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
</section>

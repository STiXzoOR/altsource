---
import Icon from './Icon.astro';
import { getSite, universalLink } from '../lib/data.mjs';
const { compact = false } = Astro.props;
const site = await getSite();
const buttons = [
  ['Add to AltStore PAL', universalLink(site.urls.pal), true],
  ['Add to AltStore Classic', universalLink(site.urls.classic), false],
  ['Add to SideStore', `sidestore://source?url=${encodeURIComponent(site.urls.classic)}`, false],
];
const raw = [['PAL', site.urls.pal], ['Classic / SideStore', site.urls.classic]];
---
<div class="flex flex-wrap gap-2">
  {buttons.map(([label, href, primary]) => (
    <a href={href} class={`inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold shadow-sm transition ${primary ? 'bg-accent text-white hover:opacity-90' : 'border border-zinc-200 bg-white text-zinc-800 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800'}`}>
      <Icon name="download" class="size-4" />{label}
    </a>
  ))}
</div>
{!compact && (
  <details class="mt-3 text-sm">
    <summary class="cursor-pointer text-zinc-500 hover:text-accent dark:text-zinc-400">Raw source URLs</summary>
    <ul class="mt-2 grid gap-2">
      {raw.map(([label, url]) => (
        <li class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-2 dark:border-zinc-700 dark:bg-zinc-900">
          <span class="w-28 shrink-0 text-zinc-500 dark:text-zinc-400">{label}</span>
          <code class="min-w-0 flex-1 truncate font-mono text-xs">{url}</code>
          <button type="button" data-copy={url} class="rounded-md p-1.5 text-zinc-500 hover:bg-zinc-100 hover:text-accent dark:hover:bg-zinc-800" aria-label="Copy URL"><Icon name="copy" class="size-4" /></button>
        </li>
      ))}
    </ul>
  </details>
)}
<script>
  for (const b of document.querySelectorAll('[data-copy]')) {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy); b.classList.add('text-accent'); setTimeout(() => b.classList.remove('text-accent'), 1200); } catch {}
    });
  }
</script>

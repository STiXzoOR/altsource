{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stixzoor.github.io/altsource/schema/app.schema.json",
  "title": "AltStore app",
  "type": "object",
  "required": ["name", "bundleIdentifier", "developerName", "localizedDescription", "iconURL", "versions"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "bundleIdentifier": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
    "marketplaceID": { "type": "string", "pattern": "^[0-9]+$", "description": "Apple ID of the notarized app (App Store Connect → App Information). Required for AltStore PAL." },
    "developerName": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "localizedDescription": { "type": "string" },
    "localizedSubtitles": { "type": "object", "additionalProperties": { "type": "string" } },
    "localizedDescriptions": { "type": "object", "additionalProperties": { "type": "string" } },
    "iconURL": { "type": "string" },
    "tintColor": { "type": "string" },
    "category": { "enum": ["developer", "entertainment", "games", "lifestyle", "other", "photo-video", "social", "utilities"] },
    "screenshots": {
      "oneOf": [
        { "$ref": "#/$defs/screenshotList" },
        { "type": "object", "properties": { "iphone": { "$ref": "#/$defs/screenshotList" }, "ipad": { "$ref": "#/$defs/screenshotList" } }, "additionalProperties": false }
      ]
    },
    "versions": { "type": "array", "minItems": 1, "items": { "$ref": "version.schema.json" } },
    "appPermissions": {
      "type": "object",
      "properties": {
        "entitlements": { "type": "array", "items": { "type": "string" } },
        "privacy": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "patreon": { "type": "object" },
    "upstream": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["altstore", "github", "adp"] },
        "url": { "type": "string" },
        "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "asset": { "type": "string" },
        "prerelease": { "type": "boolean" },
        "notes": { "enum": ["body", "none"] },
        "sync": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "const": "*" }] },
        "news": { "type": "boolean" },
        "notify": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "altstore" } } }, "then": { "required": ["url"] } },
        { "if": { "properties": { "type": { "const": "github" } } }, "then": { "required": ["repo"] } },
        { "if": { "properties": { "type": { "const": "adp" } } }, "then": { "required": ["url"] } }
      ]
    }
  },
  "$defs": {
    "screenshot": {
      "anyOf": [
        { "type": "string" },
        { "type": "object", "required": ["imageURL"], "properties": { "imageURL": { "type": "string" }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "screenshotList": { "type": "array", "items": { "$ref": "#/$defs/screenshot" } }
  }
}
